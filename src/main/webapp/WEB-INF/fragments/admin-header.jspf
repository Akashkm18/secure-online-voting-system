<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle != null ? pageTitle : 'Admin Console'}"/> - Secure Online Voting System</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body class="admin-shell">

<!-- Admin Top Navigation Bar -->
<header class="admin-topbar">
    <div style="display:flex; align-items:center; gap:1rem;">
        <a href="${pageContext.request.contextPath}/admin/dashboard" class="admin-brand">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Alliance Voting</span>
        </a>
        <span class="admin-badge">Admin Console</span>
    </div>

    <div class="admin-top-actions">
        <a href="${pageContext.request.contextPath}/" target="_blank" rel="noopener" class="admin-public-link" title="Open Public Voter Portal">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            <span>Public Portal</span>
        </a>

        <div class="admin-user-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <span><c:out value="${sessionScope.userName != null ? sessionScope.userName : 'Administrator'}"/></span>
        </div>

        <form action="${pageContext.request.contextPath}/logout" method="post" style="display:inline; margin:0;">
            <input type="hidden" name="_csrf" value="${csrfToken}">
            <button type="submit" class="admin-signout-btn" title="Sign Out of Admin Console">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Sign Out</span>
            </button>
        </form>
    </div>
</header>

<div class="admin-layout">
    <!-- Admin Sidebar Navigation -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-nav-title">Navigation</div>

        <a href="${pageContext.request.contextPath}/admin/dashboard" class="sidebar-link ${activeNav == 'dashboard' ? 'active' : ''}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
            </svg>
            <span>Dashboard</span>
        </a>

        <a href="${pageContext.request.contextPath}/admin/elections" class="sidebar-link ${activeNav == 'elections' ? 'active' : ''}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
            </svg>
            <span>Elections</span>
        </a>

        <a href="${pageContext.request.contextPath}/admin/candidates" class="sidebar-link ${activeNav == 'candidates' ? 'active' : ''}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>Candidates</span>
        </a>

        <a href="${pageContext.request.contextPath}/admin/voters" class="sidebar-link ${activeNav == 'voters' ? 'active' : ''}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="16" rx="2"/>
                <circle cx="9" cy="10" r="2"/>
                <line x1="15" y1="8" x2="17" y2="8"/>
                <line x1="15" y1="12" x2="17" y2="12"/>
                <line x1="7" y1="16" x2="17" y2="16"/>
            </svg>
            <span>Voters Registry</span>
        </a>

        <a href="${pageContext.request.contextPath}/admin/results" class="sidebar-link ${activeNav == 'results' ? 'active' : ''}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"/>
                <line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
            <span>Results & Tally</span>
        </a>

        <a href="${pageContext.request.contextPath}/admin/audit-logs" class="sidebar-link ${activeNav == 'audit-logs' ? 'active' : ''}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Security Audit Logs</span>
        </a>

        <div class="sidebar-bottom">
            <div class="sidebar-status-box">
                <span class="status-dot"></span>
                <span>Protected by TLS & CSRF</span>
            </div>
        </div>
    </aside>

    <!-- Main Content Container -->
    <main class="admin-main">
        <!-- Flash Messages -->
        <c:if test="${not empty flashSuccess}">
            <div class="flash-alert flash-success" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <span><c:out value="${flashSuccess}"/></span>
            </div>
        </c:if>

        <c:if test="${not empty flashError}">
            <div class="flash-alert flash-error" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span><c:out value="${flashError}"/></span>
            </div>
        </c:if>
