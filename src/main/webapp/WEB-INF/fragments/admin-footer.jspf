    </main>
</div>

<!-- Global Styled Confirmation Modal (Accessible Dialog, Zero window.confirm) -->
<div class="modal-overlay" id="adminConfirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle">
    <div class="modal-box" style="max-width: 440px;">
        <div class="modal-header">
            <h3 class="modal-title" id="confirmModalTitle">Confirm Action</h3>
            <button type="button" class="modal-close-btn" id="confirmModalCloseBtn" aria-label="Close modal">&times;</button>
        </div>
        <div class="modal-body">
            <p id="confirmModalMessage" style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.5; margin: 0;">
                Are you sure you wish to execute this operation?
            </p>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary btn-sm" id="confirmModalCancelBtn">Cancel</button>
            <button type="button" class="btn btn-primary btn-sm" id="confirmModalConfirmBtn">Confirm</button>
        </div>
    </div>
</div>

<!-- Client script for modal operations, photo upload previews, and CSP compliance -->
<script src="${pageContext.request.contextPath}/js/admin.js"></script>
</body>
</html>
